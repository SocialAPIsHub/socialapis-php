{
    "name": "socialapishub/socialapis",
    "description": "PHP SDK for Facebook and Instagram public data: Pages, posts, groups, comments, Meta Ads Library, Marketplace, Instagram profiles and reels. No OAuth, no Meta app review.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "facebook",
        "instagram",
        "facebook-api",
        "instagram-api",
        "facebook-scraper",
        "instagram-scraper",
        "facebook-ads-library",
        "meta-ads-library",
        "facebook-marketplace",
        "social-media-api",
        "socialapis"
    ],
    "homepage": "https://socialapis.io",
    "support": {
        "issues": "https://github.com/SocialAPIsHub/socialapis-php/issues",
        "source": "https://github.com/SocialAPIsHub/socialapis-php",
        "docs": "https://docs.socialapis.io",
        "email": "support@socialapis.io"
    },
    "authors": [
        {
            "name": "SocialAPIs",
            "email": "support@socialapis.io",
            "homepage": "https://socialapis.io"
        }
    ],
    "require": {
        "php": ">=8.1",
        "ext-curl": "*",
        "ext-json": "*"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "SocialAPIs\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SocialAPIs\\Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "phpunit"
    },
    "config": {
        "sort-packages": true
    }
}
